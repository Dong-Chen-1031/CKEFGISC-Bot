DISCORD_BOT_TOKEN=你的機器人Token

# /notify 是否需要「管理伺服器」權限
# true  = 只有管理員能群發（預設，建議）
# false = 所有人都能用 /notify，包含一次私訊整個身分組
NOTIFY_REQUIRE_PERMISSION=true

# 是否允許匿名寄送
# true  = 可以用 /notify send anonymous:True 隱藏發布者（預設）
# false = 停用匿名，所有新通知一律顯示發布者
NOTIFY_ALLOW_ANONYMOUS=true

# 訊息紀錄的總開關
# true  = 開發者可以用 /msglog 指令設定各伺服器的訊息紀錄（預設）
# false = /msglog 指令停用，所有伺服器一律不記錄（設定會保留）
MESSAGE_LOG_ENABLED=true
